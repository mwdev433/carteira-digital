# Copie para .env para trocar os valores padrão (opcional em desenvolvimento).

# ------------------------------- MySQL ------------------------------------
DB_NAME=carteira
DB_USER=carteira
DB_PASSWORD=troque_esta_senha_do_banco
DB_ROOT_PASSWORD=troque_esta_senha_root

# -------------------------------- JWT -------------------------------------
# Gere uma chave forte com:  openssl rand -hex 32
JWT_SECRET=troque-esta-chave-jwt-por-uma-aleatoria-de-64-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------- Regras -----------------------------------
SALDO_INICIAL=1000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
